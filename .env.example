# Copy to .env.local for local development, or run `vercel env pull .env.local --yes`.
# Never commit real values. Production values live in Vercel's environment variables.

# Postgres (Neon via the Vercel Marketplace in production; any local Postgres in development).
DATABASE_URL=postgres://lah:${POSTGRES_PASSWORD}@localhost:5432/lah_dev

# 32 random bytes, base64. Encrypts LinkedIn tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
