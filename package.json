{
  "name": "linkedin-agent-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "knip": "knip",
    "duplication": "jscpd",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run duplication && npm run db:check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@vercel/functions": "3.11.0",
    "drizzle-orm": "0.45.4",
    "mcp-handler": "2.3.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
